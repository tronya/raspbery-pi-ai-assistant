[Unit]
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
Description=Marstek battery logger (read-only, every 30 s)
[Service]
User=tronyak
ExecStart=/usr/bin/python3 /home/tronyak/marstek_logger.py
Restart=always
RestartSec=15
[Install]
WantedBy=multi-user.target
