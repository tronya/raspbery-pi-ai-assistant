# Copy to ~/.env on the Raspberry Pi (chmod 600) and fill in. NEVER commit the real file.
# Keep comments on their own lines: the scripts read KEY=VALUE literally.

# Telegram bot token from @BotFather (required for the bot, alerts, work-time messages)
TELEGRAM_TOKEN=put-your-telegram-bot-token-here

# Local language models served by Ollama
# fast model, used for English messages
OLLAMA_MODEL=qwen2.5:0.5b
# bigger model, used for messages that contain Cyrillic
OLLAMA_MODEL_UK=gemma3:1b
# en | uk: language of the fast model's answers
REPLY_LANG=en

# Air-raid alerts: token from https://alerts.in.ua (see pi/alertwatch.py)
ALERTS_API_TOKEN=put-your-alerts-in-ua-token-here

# Work-time companion
# remind to take a break every N minutes of continuous work
WORK_REMIND_MIN=45
# uk = hand-written Ukrainian lines, en = written by the local model
WORK_LANG=uk

# Marstek battery (local UDP API; enable "Open API" in the Marstek app)
MARSTEK_IP=192.168.x.x
MARSTEK_INTERVAL=30
